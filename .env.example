VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Twilio, server-only. Each agent gets its own number bought on this account
# and imported into Vapi. From console.twilio.com > Account info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional. A number you already own on that account, shared by every agent
# instead of buying one each. Trial accounts can hold only one number.
TWILIO_PHONE_NUMBER=
# Optional. Enables live webhooks (contact + booking tools) via a public URL,
# for example https://api.example.com. Without it, calls are pulled from Vapi.
PUBLIC_BASE_URL=
# The server address tool/run.sh builds into the app. A phone needs your Mac's
# LAN address, for example http://10.0.0.196:8080. Leave empty for demo mode.
API_BASE_URL=
# Optional local overrides
PORT=8080
DATA_FILE=.data/store.json
